{
 "manifest_version": 3,
 "name": "Sudowrite Adapter — Xưởng Nội Dung",
 "version": "0.7.3",
 "description": "Sudowrite Adapter của Xưởng: điền Story Bible vào Sudowrite, tự viết chương trên Sudowrite khi Xưởng giao việc tự động (tốn credit Sudowrite), đưa chương về Xưởng, điền hồ sơ truyện vào Inkstone. Không tự đăng truyện, không lưu mật khẩu.",
 "permissions": [
  "storage",
  "tabs",
  "alarms"
 ],
 "host_permissions": [
  "https://inkstone.webnovel.com/*",
  "https://xuong-noi-dung-khaki.vercel.app/*",
  "https://editor.sudowrite.com/*",
  "http://127.0.0.1:8765/*"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "action": {
  "default_popup": "popup.html",
  "default_title": "Sudowrite Adapter"
 },
 "content_scripts": [
  {
   "matches": [
    "https://xuong-noi-dung-khaki.vercel.app/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
   ],
   "js": [
    "studio-content.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://inkstone.webnovel.com/*"
   ],
   "js": [
    "inkstone-content.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://editor.sudowrite.com/*"
   ],
   "js": [
    "sudowrite-content.js",
    "sudowrite-auto.js"
   ],
   "run_at": "document_idle"
  }
 ]
}

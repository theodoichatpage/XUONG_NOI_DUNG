{
 "manifest_version":3,"name":"Xưởng Nội Dung — Webnovel Publisher","version":"0.1.0","description":"Điền hồ sơ truyện từ Xưởng vào form tạo truyện trên Inkstone. Không tự bấm Create, không lưu mật khẩu.",
 "permissions":["storage","tabs"],
 "host_permissions":["https://inkstone.webnovel.com/*","https://xuong-noi-dung-khaki.vercel.app/*"],
 "background":{"service_worker":"background.js"},
 "action":{"default_popup":"popup.html","default_title":"Xưởng Webnovel Publisher"},
 "content_scripts":[
 {"matches":["https://xuong-noi-dung-khaki.vercel.app/*","http://localhost:8080/*","http://127.0.0.1:8080/*"],"js":["studio-content.js"],"run_at":"document_idle"},
 {"matches":["https://inkstone.webnovel.com/*"],"js":["inkstone-content.js"],"run_at":"document_idle"}
 ]
}

{
 "manifest_version": 3,
 "name": "Xưởng Nội Dung — Publisher (Webnovel + Sudowrite)",
 "version": "0.3.3",
 "description": "Điền hồ sơ truyện vào Inkstone, điền Story Bible (Braindump, Genre, Synopsis) vào Sudowrite và lấy chương từ Sudowrite về Xưởng. Không bấm Create/Generate, không lưu mật khẩu.",
 "permissions": [
  "storage",
  "tabs"
 ],
 "host_permissions": [
  "https://inkstone.webnovel.com/*",
  "https://xuong-noi-dung-khaki.vercel.app/*",
  "https://editor.sudowrite.com/*"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "action": {
  "default_popup": "popup.html",
  "default_title": "Xưởng Webnovel Publisher"
 },
 "content_scripts": [
  {
   "matches": [
    "https://xuong-noi-dung-khaki.vercel.app/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
   ],
   "js": [
    "studio-content.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://inkstone.webnovel.com/*"
   ],
   "js": [
    "inkstone-content.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://editor.sudowrite.com/*"
   ],
   "js": [
    "sudowrite-content.js"
   ],
   "run_at": "document_idle"
  }
 ]
}
